{
  "appId": "com.neyond.xbrllite",
  "productName": "XBRL Lite",
  "directories": { "output": "build" },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "icons/**",
    "!server/**"
  ],
  "extraResources": [
    { "from": "./server", "to": "server", "filter": ["**/*"] } 
  ],
  "asar": true,
  "win": {
    "icon": "icons/output.ico",
    "target": ["portable"],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "signAndEditExecutable": false
  }
}
